# SkillGap Backend Environment Configuration

# Environment mode: 'development', 'test', or 'production'
# In development, unauthenticated requests fall back to the seeded demo user (usr_prod_001).
# In production, authentication is strictly enforced and default dev secret keys are rejected.
ENVIRONMENT=development

# Database Connection URL (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./skillgap.db

# Cryptographic Secret Key for JWT signing (MUST be changed in production)
SECRET_KEY=dev_secret_key_skillgap_matrix_9901_production_ready
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Allowed CORS Origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# DAG Scoring Weights (Weight Demand + Weight Gap + Weight Value MUST sum to 1.0)
WEIGHT_DEMAND=0.5
WEIGHT_GAP=0.3
WEIGHT_VALUE=0.2

# Prerequisite Gate Threshold (0.00 to 1.00 minimum proficiency required on upstream nodes)
PREREQUISITE_PASS_THRESHOLD=0.50
